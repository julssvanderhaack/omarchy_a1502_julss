[Desktop Entry]
Type=Application
Name=Música
GenericName=Reproductor de música
Comment=Reproduce tu música local con letras sincronizadas y ecualizador
Exec=julss-music %U
Icon=multimedia-audio-player
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=música;music;audio;mp3;flac;letras;lyrics;ecualizador;player;reproductor;
MimeType=audio/mpeg;audio/mp3;audio/x-mp3;audio/flac;audio/x-flac;audio/ogg;audio/x-vorbis+ogg;audio/vorbis;audio/opus;audio/x-opus+ogg;audio/mp4;audio/m4a;audio/x-m4a;audio/aac;audio/x-aac;audio/x-m4b;audio/wav;audio/x-wav;audio/vnd.wave;audio/x-ape;audio/x-wavpack;audio/x-aiff;audio/aiff;audio/x-ms-wma;audio/x-musepack;audio/x-tta;audio/x-matroska;audio/webm;audio/x-dsf;audio/x-dff;audio/ac3;audio/x-mod;audio/x-xm;audio/x-it;audio/x-s3m;audio/x-mpegurl;audio/mpegurl;application/vnd.apple.mpegurl;
StartupWMClass=julss-music
StartupNotify=false
Actions=PlayPause;Next;Previous;

[Desktop Action PlayPause]
Name=Reproducir / pausa
Exec=julss-music --toggle

[Desktop Action Next]
Name=Siguiente
Exec=julss-music --next

[Desktop Action Previous]
Name=Anterior
Exec=julss-music --prev
