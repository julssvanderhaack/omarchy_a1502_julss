#!/bin/bash

# On resume brcmfmac reloads the BCM43602 firmware and the first association
# sometimes times out. NetworkManager usually recovers on its own retry; if it
# hasn't after a grace period, bounce the radio, and as a last resort reset the
# card. Does nothing if wifi is switched off or no saved network is in range.
#
# Two broken states skip straight to the card reset, since a radio bounce can't
# fix either:
# - firmware hung: kernel log full of "brcmf_msgbuf_query_dcmd: Timeout" /
#   "Failed to reserve space in commonring";
# - card gone from the bus: config space reads 0xffff ("Unable to change power
#   state from unknown to D0, device inaccessible", "MMIO read failed").
#
# The card reset unloads the driver, drops the device, does a secondary bus
# reset from its root port and rescans, so the card is enumerated from scratch
# (fresh BARs and config) before the driver loads again.
#
# --force (the wifi panel's restart button): skip the grace period and the
# in-range check and go straight to bouncing the radio, then the card reset.

set -u

IFACE=wlp3s0
CARD=0000:03:00.0
BRIDGE=0000:00:1c.2
PCIDEV=/sys/bus/pci/devices/$CARD
GRACE=30
FORCE=0
[[ ${1:-} == --force ]] && FORCE=1
START=$(date +%s)

# One run at a time (resume check and restart button can overlap); a run that
# waited for another one is done if that one already brought the wifi back.
exec 9>/run/julss-wifi-resume-check.lock
if ! flock -n 9; then
  echo "Another check is running, waiting for it"
  flock -w 300 9 || { echo "Gave up waiting"; exit 1; }
  WAITED=1
fi

connected() {
  [[ $(timeout 10 nmcli -g GENERAL.STATE device show "$IFACE" 2>/dev/null) == 100* ]]
}

wait_connected() {
  local i
  for ((i = 0; i < ${1:-$GRACE}; i++)); do
    connected && return 0
    sleep 1
  done
  return 1
}

card_on_bus() {
  [[ $(setpci -s "$CARD" VENDOR_ID.w 2>/dev/null) == 14e4 ]]
}

card_working() {
  card_on_bus && [[ -e $PCIDEV/driver && -e /sys/class/net/$IFACE ]]
}

firmware_hung() {
  journalctl -k -b -q --since "@$((START - 60))" \
    --grep 'brcmf_msgbuf_query_dcmd: Timeout|Failed to reserve space in commonring' \
    2>/dev/null | grep -q .
}

# A scan that sees no networks at all is the broken-after-resume state itself
# (the radio is up but deaf), not an empty neighbourhood, so it counts as yes.
known_network_in_range() {
  local name type ssid visible
  visible=$(timeout 30 nmcli -g SSID device wifi list ifname "$IFACE" --rescan yes 2>/dev/null)
  [[ -z ${visible//[[:space:]]/} ]] && return 0
  while IFS=: read -r name type; do
    [[ $type == 802-11-wireless ]] || continue
    ssid=$(nmcli -g 802-11-wireless.ssid connection show "$name" 2>/dev/null)
    [[ -n $ssid ]] && grep -Fxq -- "$ssid" <<<"$visible" && return 0
  done < <(nmcli -g NAME,TYPE connection show)
  return 1
}

restart_radio() {
  timeout 30 nmcli radio wifi off
  sleep 2
  timeout 30 nmcli radio wifi on
}

# Pulse Secondary Bus Reset (bridge control bit 6) on the card's root port.
bus_reset() {
  local bc
  bc=$(setpci -s "$BRIDGE" BRIDGE_CONTROL.w) || return
  setpci -s "$BRIDGE" BRIDGE_CONTROL.w="$(printf %04x $((0x$bc | 0x40)))"
  sleep 0.2
  setpci -s "$BRIDGE" BRIDGE_CONTROL.w="$bc"
  sleep 1
}

# brcmfmac_wcc (vendor module) holds a reference on brcmfmac, so it has to be
# unloaded first or modprobe fails with "Module brcmfmac is in use".
reset_card() {
  local try
  timeout 90 modprobe -r brcmfmac_wcc brcmfmac || echo "Driver unload failed"
  for try in 1 2 3; do
    [[ -e $PCIDEV ]] && echo 1 >"$PCIDEV/remove"
    bus_reset
    echo 1 >"/sys/bus/pci/devices/$BRIDGE/rescan"
    sleep 1
    card_on_bus && break
    echo "Card not back on the bus (try $try)"
  done
  modprobe brcmfmac
  card_on_bus
}

if [[ -n ${WAITED:-} ]] && connected; then
  echo "Wifi already reconnected by the other check"
  exit 0
fi

if (( FORCE )); then
  echo "Restart requested"
elif ! card_working; then
  # Give the resume hook's driver load a moment before calling it broken.
  sleep 5
fi

if ! (( FORCE )) && card_working; then
  if wait_connected; then
    echo "Wifi reconnected on its own"
    exit 0
  fi

  if [[ $(nmcli radio wifi) != enabled ]]; then
    echo "Wifi radio is off, nothing to do"
    exit 0
  fi

  if ! firmware_hung && ! known_network_in_range; then
    echo "No saved network in range, nothing to do"
    exit 0
  fi

  echo "Not connected after ${GRACE}s"
fi

if ! card_working; then
  echo "Card is not on the bus or has no driver, skipping the radio restart"
elif firmware_hung; then
  echo "Firmware is not responding, skipping the radio restart"
else
  echo "Restarting the wifi radio"
  restart_radio
  if wait_connected; then
    echo "Wifi reconnected after restarting the radio"
    exit 0
  fi
fi

echo "Resetting the wifi card (driver unload, bus reset, rescan, reload)"
reset_card || echo "Card still not answering on the bus"
# Firmware load + association took ~12 s at boot; leave room for it.
if wait_connected 60; then
  echo "Wifi reconnected after resetting the card"
  exit 0
fi

echo "Wifi still not connected"
exit 1
