#!/usr/bin/python3 -I
# Recolector de uso para agentes que Omarchy no trae (copilot, gemini, opencode).
# Imprime el mismo registro JSON que omarchy-agent-usage-<agente> para que el
# panel julss.agents los muestre. "installed": true hace que salgan aunque aún
# no tengan uso. Uso: julss-agent-usage copilot|gemini|opencode
import datetime, glob, json, os, shutil, sqlite3, sys
from collections import defaultdict

HOME = os.path.expanduser("~")
NAMES = {"copilot": "GitHub Copilot", "gemini": "Gemini", "opencode": "opencode"}


def local_date(ts):
    """ISO (UTC 'Z' o con zona) o epoch ms -> fecha local YYYY-MM-DD."""
    try:
        if isinstance(ts, (int, float)):
            d = datetime.datetime.fromtimestamp(ts / 1000 if ts > 1e11 else ts)
        else:
            d = datetime.datetime.fromisoformat(str(ts).replace("Z", "+00:00"))
            if d.tzinfo:
                d = d.astimezone()
        return d.date().isoformat()
    except Exception:
        return None


def base(agent_id):
    return {
        "schemaVersion": 1, "id": agent_id, "name": NAMES[agent_id],
        "updatedAt": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "installed": True, "ready": True, "hasLocalStats": True,
        "todayPrompts": 0, "todaySessions": 0, "todayTotalTokens": 0, "todayTokensByModel": {},
        "recentDays": [], "totalPrompts": 0, "totalSessions": 0, "activeDays": 0, "activeDates": [],
        "modelUsage": {}, "limits": [], "tierLabel": "", "usageStatusText": "", "authHelpText": "",
    }


def finish(rec, prompts_by_day, sessions_by_day, tokens_by_day, today_models, models, total_sessions):
    today = datetime.date.today().isoformat()
    days = sorted(set(prompts_by_day) | set(tokens_by_day) | set(sessions_by_day))
    rec["totalPrompts"] = sum(prompts_by_day.values())
    rec["totalSessions"] = total_sessions
    rec["activeDates"] = days
    rec["activeDays"] = len(days)
    rec["todayPrompts"] = prompts_by_day.get(today, 0)
    rec["todaySessions"] = len(sessions_by_day.get(today, ()))
    rec["todayTokensByModel"] = dict(today_models)
    rec["todayTotalTokens"] = sum(today_models.values())
    rec["recentDays"] = [
        {"date": (datetime.date.today() - datetime.timedelta(days=i)).isoformat(),
         "messageCount": tokens_by_day.get((datetime.date.today() - datetime.timedelta(days=i)).isoformat(), 0)}
        for i in range(6, -1, -1)]
    rec["modelUsage"] = {m: dict(v) for m, v in models.items()}
    return rec


def copilot():
    rec = base("copilot")
    db = os.path.join(HOME, ".copilot/session-store.db")
    prompts, sessions, tokens = defaultdict(int), defaultdict(set), defaultdict(int)
    today_models, models = defaultdict(int), {}
    total_sessions = 0
    if os.path.exists(db):
        try:
            c = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=2)
            total_sessions = c.execute("select count(*) from sessions").fetchone()[0]
            for sid, ts in c.execute("select session_id, timestamp from turns"):
                d = local_date(ts)
                if d:
                    prompts[d] += 1
                    sessions[d].add(sid)
            today = datetime.date.today().isoformat()
            for model, i, o, cr, cw, ts in c.execute(
                    "select model, input_tokens, output_tokens, cache_read_tokens, cache_write_tokens, created_at"
                    " from assistant_usage_events"):
                i, o, cr, cw = (i or 0), (o or 0), (cr or 0), (cw or 0)
                m = models.setdefault(model, {"inputTokens": 0, "outputTokens": 0,
                                              "cacheReadInputTokens": 0, "cacheCreationInputTokens": 0})
                # input_tokens incluye la parte leída de caché: se separa.
                m["inputTokens"] += max(0, i - cr)
                m["outputTokens"] += o
                m["cacheReadInputTokens"] += cr
                m["cacheCreationInputTokens"] += cw
                d = local_date(ts)
                if d:
                    tokens[d] += i + o + cw
                    if d == today:
                        today_models[model] += i + o + cw
        except sqlite3.Error as e:
            rec["usageStatusText"] = "Historial no disponible"
            rec["authHelpText"] = f"No se pudo leer ~/.copilot/session-store.db: {e}"
    rec["tierLabel"] = "Copilot CLI" if total_sessions else "Sin uso todavía"
    return finish(rec, prompts, sessions, tokens, today_models, models, total_sessions)


def gemini():
    rec = base("gemini")
    prompts, sessions, tokens = defaultdict(int), defaultdict(set), defaultdict(int)
    today_models, models = defaultdict(int), {}
    today = datetime.date.today().isoformat()
    session_ids = set()
    for f in glob.glob(os.path.join(HOME, ".gemini/tmp/*/chats/*.json")):
        try:
            chat = json.load(open(f))
        except Exception:
            continue
        sid = chat.get("sessionId") or f
        session_ids.add(sid)
        for msg in chat.get("messages", []):
            d = local_date(msg.get("timestamp"))
            if not d:
                continue
            if msg.get("type") == "user":
                prompts[d] += 1
                sessions[d].add(sid)
            t = msg.get("tokens") or {}
            model = msg.get("model")
            if model and t:
                m = models.setdefault(model, {"inputTokens": 0, "outputTokens": 0,
                                              "cacheReadInputTokens": 0, "cacheCreationInputTokens": 0})
                cached = t.get("cached", 0) or 0
                m["inputTokens"] += max(0, (t.get("input", 0) or 0) - cached)
                m["outputTokens"] += (t.get("output", 0) or 0) + (t.get("thoughts", 0) or 0)
                m["cacheReadInputTokens"] += cached
                total = t.get("total") or ((t.get("input", 0) or 0) + (t.get("output", 0) or 0))
                tokens[d] += total
                if d == today:
                    today_models[model] += total
    rec["tierLabel"] = "Gemini CLI" if session_ids else "Sin uso todavía"
    return finish(rec, prompts, sessions, tokens, today_models, models, len(session_ids))


def opencode():
    rec = base("opencode")
    prompts, sessions, tokens = defaultdict(int), defaultdict(set), defaultdict(int)
    today_models, models = defaultdict(int), {}
    today = datetime.date.today().isoformat()
    root = os.path.join(HOME, ".local/share/opencode/storage")
    session_ids = set(os.path.basename(p)[:-5] for p in glob.glob(os.path.join(root, "session/*/*.json")))
    for f in glob.glob(os.path.join(root, "message/*/*.json")):
        try:
            msg = json.load(open(f))
        except Exception:
            continue
        d = local_date((msg.get("time") or {}).get("created"))
        if not d:
            continue
        sid = msg.get("sessionID") or os.path.basename(os.path.dirname(f))
        if msg.get("role") == "user":
            prompts[d] += 1
            sessions[d].add(sid)
            continue
        t = msg.get("tokens") or {}
        model = msg.get("modelID")
        if model and t:
            cache = t.get("cache") or {}
            m = models.setdefault(model, {"inputTokens": 0, "outputTokens": 0,
                                          "cacheReadInputTokens": 0, "cacheCreationInputTokens": 0})
            m["inputTokens"] += t.get("input", 0) or 0
            m["outputTokens"] += (t.get("output", 0) or 0) + (t.get("reasoning", 0) or 0)
            m["cacheReadInputTokens"] += cache.get("read", 0) or 0
            m["cacheCreationInputTokens"] += cache.get("write", 0) or 0
            total = (t.get("input", 0) or 0) + (t.get("output", 0) or 0) + (cache.get("write", 0) or 0)
            tokens[d] += total
            if d == today:
                today_models[model] += total
    rec["tierLabel"] = "opencode" if session_ids else "Sin uso todavía"
    return finish(rec, prompts, sessions, tokens, today_models, models, len(session_ids))


COLLECTORS = {"copilot": copilot, "gemini": gemini, "opencode": opencode}

if __name__ == "__main__":
    agent = sys.argv[1] if len(sys.argv) > 1 else ""
    if agent not in COLLECTORS:
        sys.exit("uso: julss-agent-usage " + "|".join(COLLECTORS))
    print(json.dumps(COLLECTORS[agent]()))
