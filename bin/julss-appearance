#!/usr/bin/env python3
# Apariencia para el panel Pantalla (julss.monitor): lista y aplica tema de
# Omarchy, fondo, paleta GTK, iconos y cursor. GTK/iconos/cursor se guardan en
# ~/.config/julss/appearance.json y el hook theme-set.d/julss-icons los
# reaplica tras cada cambio de tema (Omarchy los pisa antes de los hooks).
#
#   julss-appearance state                 JSON con opciones y valores actuales
#   julss-appearance set theme|bg|gtk|icons|cursor VALOR
#   julss-appearance apply                 reaplica gtk/iconos/cursor guardados
#   julss-appearance follow-theme          tras cambiar de tema de Omarchy: GTK
#                                          con los colores del tema e iconos los
#                                          que pone Omarchy (icons.theme); cursor igual
#   julss-appearance set bar-position top|bottom|left|right
#   julss-appearance set bar-transparency 0-100
#   julss-appearance set bar-color '#rrggbb'|theme
#                                          fondo de la barra: se escribe en
#                                          ~/.config/omarchy/shell.toml [bar]
#                                          (la shell lo vigila y gana al tema);
#                                          el color vuelve al del tema en cada
#                                          cambio de tema, la transparencia no
#   julss-appearance set foot-transparency 0-100
#                                          alpha de foot (foot.ini) y en vivo
#                                          por OSC 11 a las terminales abiertas
#   julss-appearance set win-active|win-inactive 0-100
#                                          opacidad de ventanas (reglas de
#                                          opacity en hypr/looknfeel.lua)
#   julss-appearance open-bg-dir           abre (creándola) la carpeta de fondos
#                                          extra del tema actual
import json, os, re, subprocess, sys
from pathlib import Path

HOME = Path.home()
CONF = HOME / ".config/julss/appearance.json"
STATE = HOME / ".local/state/omarchy/current"
SYS_THEMES = Path(os.environ.get("OMARCHY_PATH", "/usr/share/omarchy")) / "themes"
USER_THEMES = HOME / ".config/omarchy/themes"
ICON_DIRS = [HOME / ".local/share/icons", HOME / ".icons", Path("/usr/share/icons")]
IMG = {".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp"}
DEFAULTS = {"gtk": "hackerman", "icons": "Papirus-Dark-Hackerman-Mint", "cursor": "Bibata-Modern-Ice"}
HYPR = HOME / ".config/hypr/hyprland.lua"
USER_SHELL = HOME / ".config/omarchy/shell.toml"
SHELL_JSON = HOME / ".config/omarchy/shell.json"
FOOT_INI = HOME / ".config/foot/foot.ini"
LOOKNFEEL = HOME / ".config/hypr/looknfeel.lua"
# Reglas de looknfeel.lua cuya opacidad se controla ("activa inactiva").
OPACITY_RULE = re.compile(r'^(o\.window\(\{ tag = "(?:default-opacity|chromium-based-browser|firefox-based-browser)" \}, \{ opacity = ")([0-9.]+) ([0-9.]+)(" \}\))', re.M)
HEX = re.compile(r"^#[0-9a-fA-F]{6}$")


def run(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True).stdout.strip()


def load():
    try:
        return {**DEFAULTS, **json.loads(CONF.read_text())}
    except Exception:
        return dict(DEFAULTS)


def save(conf):
    CONF.parent.mkdir(parents=True, exist_ok=True)
    CONF.write_text(json.dumps(conf, indent=2) + "\n")


def pretty(slug):
    return " ".join(w[:1].upper() + w[1:] for w in slug.split("-"))


def theme_slugs():
    names = set()
    for d in (USER_THEMES, SYS_THEMES):
        if d.is_dir():
            names |= {p.name for p in d.iterdir() if p.is_dir()}
    return sorted(names)


# Temas instalados desde git (p. ej. Ayaka) no traen colors.toml: Omarchy lo
# genera solo para el tema activo, así que follow-theme guarda aquí una copia.
COLORS_CACHE = HOME / ".local/state/julss/theme-colors"


def theme_colors(slug):
    for f in (USER_THEMES / slug / "colors.toml", SYS_THEMES / slug / "colors.toml",
              COLORS_CACHE / f"{slug}.toml"):
        if f.is_file():
            return f
    return None


def is_light(colors):
    return run("omarchy-theme-color", "--file", str(colors), "mode") == "light"


def backgrounds():
    name = (STATE / "theme.name").read_text().strip() if (STATE / "theme.name").exists() else ""
    files = []
    for d in (HOME / ".config/omarchy/backgrounds" / name, STATE / "theme/backgrounds"):
        if d.is_dir():
            files += [p for p in d.iterdir() if p.is_file() and p.suffix.lower() in IMG]
    out, seen = [], set()
    for p in sorted(files, key=lambda p: p.name):
        real = str(p.resolve())
        if real in seen:
            continue
        seen.add(real)
        label = re.sub(r"^\d+-", "", p.stem).replace("-", " ").replace("_", " ")
        out.append({"value": real, "label": label[:1].upper() + label[1:]})
    return out


def icon_themes(cursors):
    found = {}
    for base in ICON_DIRS:
        if not base.is_dir():
            continue
        for d in sorted(base.iterdir()):
            if d.name in ("default", "hicolor", "locolor") or d.name in found or not d.is_dir():
                continue
            has_cursors = (d / "cursors").is_dir()
            has_icons = any(c.is_dir() and c.name != "cursors" for c in d.iterdir())
            if (cursors and has_cursors) or (not cursors and has_icons and (d / "index.theme").exists()):
                found[d.name] = d.name
    return [{"value": k, "label": k.replace("-", " ")} for k in sorted(found, key=str.lower)]


def gtk_options():
    opts = [{"value": "adwaita", "label": "Adwaita oscuro (sin colores)"},
            {"value": "adwaita-light", "label": "Adwaita claro (sin colores)"}]
    for s in theme_slugs():
        if theme_colors(s):
            opts.append({"value": s, "label": "Colores " + pretty(s)})
    return opts


def apply_gtk(value):
    gs = ["gsettings", "set", "org.gnome.desktop.interface"]
    light = value == "adwaita-light"
    if value.startswith("adwaita"):
        for v in ("3.0", "4.0"):
            f = HOME / f".config/gtk-{v}/gtk.css"
            if f.exists() and "julss-gtk-theme-colors" in f.read_text().split("\n", 1)[0]:
                f.unlink()
    else:
        colors = theme_colors(value)
        if not colors:
            return
        light = is_light(colors)
        subprocess.run(["julss-gtk-theme-colors", str(colors)])
    subprocess.run(gs + ["color-scheme", "prefer-light" if light else "prefer-dark"])
    # Cambiar gtk-theme obliga a GTK3/GTK4 a recargar estilos (y gtk.css) en caliente.
    subprocess.run(gs + ["gtk-theme", "julss-recarga"])
    subprocess.run(gs + ["gtk-theme", "Adwaita" if light else "Adwaita-dark"])


def restart_gtk_apps():
    # libadwaita carga gtk.css solo al arrancar: se reabre Nautilus para que
    # la paleta nueva se vea ya. Otras apps GTK abiertas la toman al reabrirlas.
    if subprocess.run(["pgrep", "-x", "nautilus"], capture_output=True).returncode == 0:
        subprocess.run(["nautilus", "-q"], capture_output=True)
        subprocess.run(["hyprctl", "dispatch", 'hl.dsp.exec_cmd("nautilus --new-window")'], capture_output=True)


def apply_icons(value):
    if not any((d / value).is_dir() for d in ICON_DIRS):
        return
    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", value])


def apply_cursor(value):
    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "cursor-theme", value])
    subprocess.run(["hyprctl", "setcursor", value, "24"], capture_output=True)
    idx = HOME / ".local/share/icons/default/index.theme"
    idx.parent.mkdir(parents=True, exist_ok=True)
    idx.write_text(f"[Icon Theme]\nInherits={value}\n")
    if HYPR.exists():
        s = HYPR.read_text()
        n = re.sub(r'(hl\.env\("(?:X|HYPR)CURSOR_THEME",\s*")[^"]*(")', lambda m: m.group(1) + value + m.group(2), s)
        if n != s:
            HYPR.write_text(n)


def toml_get(path, section, key):
    cur = None
    try:
        lines = path.read_text().splitlines()
    except OSError:
        return None
    for line in lines:
        t = line.strip()
        m = re.match(r"^\[([A-Za-z0-9_-]+)\]", t)
        if m:
            cur = m.group(1)
        elif cur == section:
            m = re.match(rf'^{re.escape(key)}\s*=\s*"?([^"#]+?)"?\s*(#.*)?$', t)
            if m:
                return m.group(1).strip()
    return None


def toml_set(path, section, key, value):
    """Pone (o quita con value=None) section.key conservando el resto."""
    try:
        lines = path.read_text().splitlines()
    except OSError:
        lines = []
    out, cur, done, sec_end = [], None, False, None
    for line in lines:
        t = line.strip()
        m = re.match(r"^\[([A-Za-z0-9_-]+)\]", t)
        if m:
            if cur == section and not done and value is not None:
                out.append(f"{key} = {value}")
                done = True
            cur = m.group(1)
        elif cur == section and re.match(rf"^{re.escape(key)}\s*=", t):
            if value is not None and not done:
                out.append(f"{key} = {value}")
                done = True
            continue
        out.append(line)
    if value is not None and not done:
        if cur == section:
            out.append(f"{key} = {value}")
        else:
            if out and out[-1].strip():
                out.append("")
            out += [f"[{section}]", f"{key} = {value}"]
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text("\n".join(out).rstrip() + "\n")
    os.replace(tmp, path)


def palette():
    out = {}
    f = STATE / "theme/colors.toml"
    try:
        for line in f.read_text().splitlines():
            m = re.match(r'^([a-z0-9_]+)\s*=\s*"(#[0-9a-fA-F]{6})"', line.strip())
            if m:
                out[m.group(1)] = m.group(2).lower()
    except OSError:
        pass
    return out


def theme_bar_color():
    v = toml_get(STATE / "theme/shell.toml", "bar", "background") or "background"
    return v.lower() if HEX.match(v) else palette().get(v, "#000000")


def theme_bar_alpha():
    try:
        return float(toml_get(STATE / "theme/shell.toml", "bar", "background-alpha") or 1)
    except ValueError:
        return 1.0


def bar_state():
    try:
        bar = json.loads(SHELL_JSON.read_text()).get("bar", {})
    except Exception:
        bar = {}
    pal = palette()
    try:
        alpha = float(toml_get(USER_SHELL, "bar", "background-alpha"))
    except (TypeError, ValueError):
        alpha = theme_bar_alpha()
    if bar.get("transparent") is True:
        alpha = 0.0
    swatches = []
    for k in ["background", "color0", "color8", "color1", "color2", "color3", "color4",
              "color5", "color6", "accent", "color7", "foreground"]:
        c = pal.get(k)
        if c and c not in swatches:
            swatches.append(c)
    custom = toml_get(USER_SHELL, "bar", "background")
    return {
        "barPosition": bar.get("position", "top"),
        "barTransparency": round((1 - max(0.0, min(1.0, alpha))) * 100),
        "barColor": custom.lower() if custom and HEX.match(custom) else "",
        "themeBarColor": theme_bar_color(),
        "barSwatches": swatches,
        "footTransparency": alpha_to_pct(foot_alpha()),
        "winActiveTransparency": alpha_to_pct(window_opacity()[0]),
        "winInactiveTransparency": alpha_to_pct(window_opacity()[1]),
    }


def pct_to_alpha(value):
    return 1 - max(0, min(100, int(float(value)))) / 100


def alpha_to_pct(alpha):
    return round((1 - max(0.0, min(1.0, alpha))) * 100)


def window_opacity():
    m = OPACITY_RULE.search(LOOKNFEEL.read_text()) if LOOKNFEEL.exists() else None
    return (float(m.group(2)), float(m.group(3))) if m else (1.0, 1.0)


def set_window_opacity(active=None, inactive=None):
    cur_a, cur_i = window_opacity()
    a = cur_a if active is None else active
    i = cur_i if inactive is None else inactive
    s = LOOKNFEEL.read_text()
    # Hyprland recarga solo al guardar y reaplica las reglas a las ventanas.
    n = OPACITY_RULE.sub(lambda m: f"{m.group(1)}{a:g} {i:g}{m.group(4)}", s)
    if n != s:
        LOOKNFEEL.write_text(n)


def foot_alpha():
    for sec in ("colors-dark", "colors"):
        v = toml_get(FOOT_INI, sec, "alpha")
        if v:
            try:
                return float(v)
            except ValueError:
                pass
    return 1.0


def set_foot_alpha(alpha):
    toml_set(FOOT_INI, "colors-dark", "alpha", f"{alpha:.2f}")
    toml_set(FOOT_INI, "colors-light", "alpha", f"{alpha:.2f}")
    # Terminales ya abiertas: OSC 11 con el prefijo [alpha] (extensión de foot).
    bg = palette().get("background", "#000000")
    seq = f"\033]11;[{round(alpha * 100)}]{bg}\033\\"
    for pid in run("pgrep", "-x", "foot").split():
        for child in run("pgrep", "-P", pid).split():
            try:
                tty = os.readlink(f"/proc/{child}/fd/0")
            except OSError:
                continue
            if tty.startswith("/dev/pts/"):
                try:
                    with open(tty, "w") as fh:
                        fh.write(seq)
                except OSError:
                    pass
                break


def set_bar(key, value):
    if key == "foot-transparency":
        set_foot_alpha(pct_to_alpha(value))
        return
    if key == "win-active":
        set_window_opacity(active=pct_to_alpha(value))
        return
    if key == "win-inactive":
        set_window_opacity(inactive=pct_to_alpha(value))
        return
    if key == "bar-position":
        subprocess.run(["omarchy-bar", "position", value], capture_output=True)
    elif key == "bar-transparency":
        pct = max(0, min(100, int(float(value))))
        # La transparencia la lleva el alpha; el modo "transparent" de Omarchy
        # la forzaría al 100 %, así que se apaga.
        try:
            if json.loads(SHELL_JSON.read_text()).get("bar", {}).get("transparent") is True:
                subprocess.run(["omarchy-bar", "transparent", "false"], capture_output=True)
        except Exception:
            pass
        toml_set(USER_SHELL, "bar", "background-alpha", f"{1 - pct / 100:.2f}")
    elif key == "bar-color":
        if value == "theme":
            toml_set(USER_SHELL, "bar", "background", None)
        elif HEX.match(value):
            toml_set(USER_SHELL, "bar", "background", f'"{value.lower()}"')
        else:
            sys.exit(f"color no válido: {value}")


def apply(conf):
    apply_gtk(conf["gtk"])
    apply_icons(conf["icons"])
    apply_cursor(conf["cursor"])


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "state"
    conf = load()
    if cmd == "state":
        cur_bg = os.path.realpath(STATE / "background")
        cur_theme = (STATE / "theme.name").read_text().strip() if (STATE / "theme.name").exists() else ""
        print(json.dumps({
            "theme": cur_theme, "themes": [{"value": s, "label": pretty(s)} for s in theme_slugs()],
            "bg": cur_bg, "bgs": backgrounds(),
            "gtk": conf["gtk"], "gtks": gtk_options(),
            "icons": conf["icons"], "iconThemes": icon_themes(False),
            "cursor": conf["cursor"], "cursors": icon_themes(True),
            **bar_state(),
        }))
    elif cmd == "apply":
        apply(conf)
    elif cmd == "follow-theme":
        name = (STATE / "theme.name").read_text().strip() if (STATE / "theme.name").exists() else ""
        current = STATE / "theme/colors.toml"
        if name and not theme_colors(name) and current.is_file():
            COLORS_CACHE.mkdir(parents=True, exist_ok=True)
            (COLORS_CACHE / f"{name}.toml").write_text(current.read_text())
        if theme_colors(name):
            conf["gtk"] = name
        else:
            conf["gtk"] = "adwaita-light" if is_light(STATE / "theme/colors.toml") else "adwaita"
        # Igual que omarchy-theme-set-gnome: icons.theme del tema o Yaru-blue.
        icons_file = STATE / "theme/icons.theme"
        conf["icons"] = (icons_file.read_text().strip() if icons_file.exists() else "") or "Yaru-blue"
        save(conf)
        apply(conf)
        # El color de barra elegido a mano no debe tapar el del tema nuevo.
        toml_set(USER_SHELL, "bar", "background", None)
    elif cmd == "open-bg-dir":
        name = (STATE / "theme.name").read_text().strip() if (STATE / "theme.name").exists() else ""
        if not name:
            sys.exit("no hay tema actual")
        d = HOME / ".config/omarchy/backgrounds" / name
        d.mkdir(parents=True, exist_ok=True)
        subprocess.Popen(["gio", "open", str(d)], start_new_session=True)
    elif cmd == "set" and len(sys.argv) == 4:
        key, value = sys.argv[2], sys.argv[3]
        if key == "theme":
            subprocess.run(["omarchy-theme-set", value])
        elif key.startswith(("bar-", "foot-", "win-")):
            set_bar(key, value)
        elif key == "bg":
            subprocess.run(["omarchy-theme-bg-set", value])
        elif key in ("gtk", "icons", "cursor"):
            conf[key] = value
            save(conf)
            {"gtk": apply_gtk, "icons": apply_icons, "cursor": apply_cursor}[key](value)
            if key == "gtk":
                restart_gtk_apps()
        else:
            sys.exit(f"clave desconocida: {key}")
    else:
        sys.exit("uso: julss-appearance state | apply | set CLAVE VALOR")


main()
