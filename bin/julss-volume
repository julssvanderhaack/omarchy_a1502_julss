#!/bin/bash
# Teclas de volumen rápidas: solo wpctl (~25 ms) en vez de
# omarchy-audio-output-volume (~240 ms: varios pactl + jq + IPC de la shell
# para el OSD). El OSD lo muestra julss.audio al ver cambiar el volumen en
# PipeWire, sin lanzar procesos.
# Uso: julss-volume raise|lower|+N|-N|mute-toggle
sink=@DEFAULT_AUDIO_SINK@
case "${1:-}" in
  raise) step=5; dir=+ ;;
  lower) step=5; dir=- ;;
  [+-][0-9]*) step=${1:1}; dir=${1:0:1} ;;
  mute-toggle) exec wpctl set-mute "$sink" toggle ;;
  *) echo "uso: julss-volume raise|lower|+N|-N|mute-toggle" >&2; exit 1 ;;
esac
wpctl set-volume -l 1.0 "$sink" "${step}%${dir}"
# Subir o bajar quita el silencio, como hace Omarchy.
[[ $(wpctl get-volume "$sink") == *MUTED* ]] && wpctl set-mute "$sink" 0
exit 0
