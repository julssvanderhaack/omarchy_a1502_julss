#!/bin/bash
# Al cambiar de tema de Omarchy, la paleta GTK pasa a los colores del tema y
# los iconos a los que pone Omarchy (icons.theme del tema). El cursor se
# mantiene. Desde el panel Pantalla se pueden cambiar a mano hasta el próximo
# cambio de tema (se guarda en ~/.config/julss/appearance.json).
"$HOME/.local/bin/julss-appearance" follow-theme
