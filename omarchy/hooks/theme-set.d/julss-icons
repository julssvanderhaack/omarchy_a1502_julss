#!/bin/bash
# Mantener fijos paleta GTK, iconos y cursor aunque cambie el tema de Omarchy.
# omarchy-theme-set-gnome pone icons.theme del tema y Adwaita claro/oscuro
# según el modo antes de que corran los hooks; aquí se reaplica lo elegido en
# el panel Pantalla (guardado en ~/.config/julss/appearance.json).
"$HOME/.local/bin/julss-appearance" apply
