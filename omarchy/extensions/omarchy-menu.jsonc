{
  // Spanish (Spain) translation of the built-in Omarchy menu.
  // Generated by re-stating every default item with the same icon/action/
  // provider/aliases/when/checked, but a translated label (and title where
  // the default set one) -- the shell's JSONC merge overwrites an id's
  // fields wholesale, so a partial override would otherwise blank out the
  // fields it didn't repeat.

  "root": {"label": "Menú"},
  "apps": {"icon": "󰀻", "label": "Aplicaciones", "aliases": ["app", "applications"], "provider": "apps"},
  "learn": {"icon": "󰧑", "label": "Aprender"},
  "trigger": {"icon": "󱓞", "label": "Acciones"},
  "style": {"icon": "", "label": "Estilo"},
  "setup": {"icon": "", "label": "Ajustes", "aliases": ["settings"]},
  "install": {"icon": "󰉉", "label": "Instalar"},
  "remove": {"icon": "󰭌", "label": "Desinstalar", "aliases": ["uninstall"]},
  "update": {"icon": "", "label": "Actualizar", "aliases": ["restart", "refresh"]},
  "about": {"icon": "", "label": "Acerca de", "action": "omarchy-launch-about"},
  "system": {"icon": "", "label": "Sistema", "aliases": ["power-menu"]},
  "system.screensaver": {"icon": "󱄄", "label": "Salvapantallas", "action": "omarchy-launch-screensaver force"},
  "system.lock": {"icon": "", "label": "Bloquear", "action": "omarchy-system-lock"},
  "system.suspend": {"icon": "󰒲", "label": "Suspender", "when": "! omarchy-toggle-enabled suspend-off", "action": "systemctl suspend"},
  "system.hibernate": {"icon": "󰤁", "label": "Hibernar", "when": "omarchy-hibernation-available", "action": "systemctl hibernate"},
  "system.logout": {"icon": "󰍃", "label": "Cerrar sesión", "action": "omarchy-system-logout"},
  "system.reboot": {"icon": "󰜉", "label": "Reiniciar", "action": "omarchy-system-reboot"},
  "system.shutdown": {"icon": "󰐥", "label": "Apagar", "action": "omarchy-system-shutdown"},
  "learn.keybindings": {"icon": "", "label": "Atajos de teclado", "action": "omarchy-menu-keybindings"},
  "learn.omarchy": {"icon": "", "label": "Omarchy", "action": "omarchy-launch-webapp 'https://omarchy.org/manual/'"},
  "learn.hyprland": {"icon": "", "label": "Hyprland", "action": "omarchy-launch-webapp 'https://wiki.hypr.land/'"},
  "learn.arch": {"icon": "󰣇", "label": "Arch", "action": "omarchy-launch-webapp 'https://wiki.archlinux.org/title/Main_page'"},
  "learn.neovim": {"icon": "", "label": "Neovim", "action": "omarchy-launch-webapp 'https://www.lazyvim.org/keymaps'"},
  "learn.bash": {"icon": "󱆃", "label": "Bash", "action": "omarchy-launch-webapp 'https://devhints.io/bash'"},
  "learn.tmux-keybindings": {"icon": "", "label": "Tmux", "action": "omarchy-menu-tmux-keybindings"},
  "learn.herdr-keybindings": {"icon": "", "label": "Herdr", "action": "omarchy-menu-herdr-keybindings"},
  "learn.community": {"icon": "󰙯", "label": "Comunidad", "action": "omarchy-launch-discord-community"},
  "trigger.emoji": {"icon": "", "label": "Emoji", "aliases": ["emoji", "emojis"], "action": "omarchy-menu-emoji"},
  "trigger.reminder": {"icon": "󰢌", "label": "Recordatorio", "aliases": ["reminder"]},
  "trigger.capture": {"icon": "", "label": "Capturar", "aliases": ["capture", "screenshot", "screenrecord", "screen-record", "screenrecording"]},
  "trigger.capture.screenshot": {"icon": "", "label": "Captura de pantalla", "action": "omarchy-capture-screenshot"},
  "trigger.capture.screenrecord.stop": {"icon": "", "label": "Detener grabación de pantalla", "when": "pgrep -f '^gpu-screen-recorder'", "action": "omarchy-capture-screenrecording --stop-recording"},
  "trigger.capture.screenrecord": {"icon": "", "label": "Grabar pantalla"},
  "trigger.capture.text": {"icon": "󰴑", "label": "Texto", "action": "omarchy-capture-text"},
  "trigger.capture.qr": {"icon": "󰐲", "label": "Código QR", "action": "omarchy-capture-qr"},
  "trigger.capture.color": {"icon": "󰃉", "label": "Color", "action": "pkill hyprpicker || hyprpicker -a"},
  "trigger.capture.screenrecord.no-audio": {"icon": "", "label": "Sin audio", "action": "omarchy-capture-screenrecording"},
  "trigger.capture.screenrecord.desktop-audio": {"icon": "", "label": "Con audio del escritorio", "action": "omarchy-capture-screenrecording --with-desktop-audio"},
  "trigger.capture.screenrecord.microphone": {"icon": "", "label": "Con audio del escritorio + micrófono", "action": "omarchy-capture-screenrecording --with-desktop-audio --with-microphone-audio"},
  "trigger.capture.screenrecord.webcam": {"icon": "", "label": "Con audio del escritorio + micrófono + webcam", "when": "omarchy-hw-webcam", "action": "omarchy-capture-screenrecording-with-webcam"},
  "trigger.transcode": {"icon": "󰧸", "label": "Convertir vídeo", "action": "omarchy-transcode"},
  "trigger.share": {"icon": "", "label": "Compartir", "aliases": ["share"]},
  "trigger.toggle": {"icon": "󰔎", "label": "Alternar", "aliases": ["toggle", "toggles"]},
  "trigger.hardware": {"icon": "", "label": "Hardware", "aliases": ["hardware", "hw"]},
  "trigger.tests": {"icon": "󰓅", "label": "Test de velocidad"},
  "trigger.hardware.laptop-display": {"icon": "󰛧", "label": "Pantalla del portátil", "when": "omarchy-hw-laptop", "action": "omarchy-hyprland-monitor-internal toggle"},
  "trigger.hardware.mirror-display": {"icon": "󰍹", "label": "Duplicar pantalla", "when": "omarchy-hw-laptop", "action": "omarchy-hyprland-monitor-internal-mirror toggle"},
  "trigger.hardware.hybrid-gpu": {"icon": "", "label": "GPU híbrida", "when": "omarchy-hw-hybrid-gpu", "action": "omarchy-launch-floating-terminal-with-presentation omarchy-toggle-hybrid-gpu"},
  "trigger.hardware.touchpad": {"icon": "󰟸", "label": "Panel táctil", "when": "omarchy-hw-touchpad", "action": "omarchy-toggle-touchpad"},
  "trigger.hardware.touchpad-haptics": {"icon": "󰌌", "label": "Vibración del panel táctil"},
  "trigger.hardware.touchpad-haptics.low": {"icon": "󰌌", "label": "Baja", "when": "omarchy-hw-dell-xps-haptic-touchpad && omarchy-cmd-present dell-xps-touchpad-haptics", "checked": "[[ \"$(dell-xps-touchpad-haptics get)\" == \"low\" ]]", "action": "dell-xps-touchpad-haptics set low"},
  "trigger.hardware.touchpad-haptics.mid": {"icon": "󰌌", "label": "Media", "when": "omarchy-hw-dell-xps-haptic-touchpad && omarchy-cmd-present dell-xps-touchpad-haptics", "checked": "[[ \"$(dell-xps-touchpad-haptics get)\" == \"mid\" ]]", "action": "dell-xps-touchpad-haptics set mid"},
  "trigger.hardware.touchpad-haptics.high": {"icon": "󰌌", "label": "Alta", "when": "omarchy-hw-dell-xps-haptic-touchpad && omarchy-cmd-present dell-xps-touchpad-haptics", "checked": "[[ \"$(dell-xps-touchpad-haptics get)\" == \"high\" ]]", "action": "dell-xps-touchpad-haptics set high"},
  "trigger.hardware.touchscreen": {"icon": "󰆽", "label": "Pantalla táctil", "when": "omarchy-hw-touchscreen", "action": "omarchy-toggle-touchscreen"},
  "trigger.reminder.set": {"icon": "󰢌", "label": "Crear uno", "aliases": ["reminder-set", "remind"], "action": "omarchy-reminder -i"},
  "trigger.reminder.show": {"icon": "󰢌", "label": "Ver todos", "action": "omarchy-reminder show"},
  "trigger.reminder.clear": {"icon": "󰢌", "label": "Borrar todos", "action": "omarchy-reminder clear"},
  "trigger.share.clipboard": {"icon": "", "label": "Portapapeles", "action": "omarchy-menu-share clipboard"},
  "trigger.share.file": {"icon": "", "label": "Archivo", "action": "omarchy-menu-share file"},
  "trigger.share.folder": {"icon": "", "label": "Carpeta", "action": "omarchy-menu-share folder"},
  "trigger.share.receive": {"icon": "󰥦", "label": "Recibir", "action": "uwsm-app -- localsend"},
  "trigger.toggle.idle-lock": {"icon": "󰅶", "label": "Mantener despierto", "action": "omarchy-toggle-idle"},
  "trigger.toggle.notifications": {"icon": "󰂛", "label": "Notificaciones", "action": "omarchy-toggle-notification-silencing"},
  "trigger.toggle.crash-capture": {"icon": "󱚡", "label": "Captura de fallos", "action": "omarchy-toggle-crash-capture"},
  "trigger.toggle.screensaver": {"icon": "󱄄", "label": "Salvapantallas", "action": "omarchy-toggle-screensaver"},
  "trigger.toggle.nightlight": {"icon": "󰔎", "label": "Luz nocturna", "action": "omarchy-toggle-nightlight"},
  "trigger.toggle.top-bar": {"icon": "󰍜", "label": "Barra de menú", "action": "omarchy-toggle-bar"},
  "trigger.toggle.battery-percentage": {"icon": "󰁹", "label": "Porcentaje de batería", "when": "omarchy-hw-laptop", "action": "omarchy-shell omarchy.power togglePercentage"},
  "trigger.toggle.workspace-layout": {"icon": "󱂬", "label": "Disposición del espacio de trabajo", "action": "omarchy-hyprland-workspace-layout-toggle"},
  "trigger.toggle.window-gaps": {"icon": "", "label": "Espaciado de ventanas", "action": "omarchy-hyprland-window-gaps-toggle"},
  "trigger.toggle.one-window-ratio": {"icon": "", "label": "Proporción de ventana única", "action": "omarchy-hyprland-window-single-square-aspect-toggle"},
  "trigger.tests.network-speedtest": {"icon": "󰓅", "label": "Test de velocidad de red", "action": "omarchy-shell shell summon omarchy.speedtest"},
  "trigger.tests.disk-speedtest": {"icon": "󰋊", "label": "Test de velocidad de disco", "action": "omarchy-shell shell summon omarchy.disk-speedtest"},
  "style.theme": {"icon": "󰸌", "label": "Tema", "aliases": ["theme", "themes"], "action": "theme=$(omarchy-theme-switcher); [[ -n $theme ]] && omarchy-theme-set \"$theme\""},
  "style.background": {"icon": "", "label": "Fondo de pantalla", "aliases": ["background", "wallpaper"], "action": "background=$(omarchy-theme-bg-switcher); [[ -n $background ]] && omarchy-theme-bg-set \"$background\""},
  "style.unlock": {"icon": "󰟵", "label": "Pantalla de desbloqueo", "aliases": ["unlock"], "action": "unlock=$(omarchy-plymouth-switcher); if [[ $unlock == default ]]; then omarchy-launch-floating-terminal-with-presentation omarchy-plymouth-reset; elif [[ -n $unlock ]]; then omarchy-launch-floating-terminal-with-presentation \"omarchy-plymouth-set-by-theme $(printf %q \"$unlock\")\"; fi"},
  "style.font": {"icon": "", "label": "Fuente", "provider": "fonts"},
  "style.bar": {"icon": "󰍜", "label": "Barra de menú"},
  "style.bar.position": {"icon": "", "label": "Posición"},
  "style.bar.transparency": {"icon": "󰂵", "label": "Transparencia", "action": "omarchy-bar transparent toggle"},
  "style.hyprland": {"icon": "", "label": "Hyprland", "action": "omarchy-launch-config-editor \"$HOME/.config/hypr/looknfeel.lua\""},
  "style.screensaver": {"icon": "󱄄", "label": "Salvapantallas"},
  "style.about": {"icon": "", "label": "Acerca de"},
  "style.bar.position.top": {"icon": "󰁝", "label": "Arriba", "action": "omarchy-bar position top"},
  "style.bar.position.bottom": {"icon": "󰁅", "label": "Abajo", "action": "omarchy-bar position bottom"},
  "style.bar.position.left": {"icon": "󰁍", "label": "Izquierda", "action": "omarchy-bar position left"},
  "style.bar.position.right": {"icon": "󰁔", "label": "Derecha", "action": "omarchy-bar position right"},
  "style.about.text": {"icon": "", "label": "Editar texto", "action": "omarchy-branding-about text"},
  "style.about.image": {"icon": "", "label": "Establecer desde imagen", "action": "omarchy-branding-about image"},
  "style.about.default": {"icon": "", "label": "Restaurar por defecto", "action": "omarchy-branding-about reset"},
  "style.screensaver.text": {"icon": "", "label": "Editar texto", "action": "omarchy-branding-screensaver text"},
  "style.screensaver.image": {"icon": "", "label": "Establecer desde imagen", "action": "omarchy-branding-screensaver image"},
  "style.screensaver.default": {"icon": "", "label": "Restaurar por defecto", "action": "omarchy-branding-screensaver reset"},
  "setup.monitors": {"icon": "󰍹", "label": "Monitores", "action": "omarchy-launch-config-editor \"$HOME/.config/hypr/monitors.lua\""},
  "setup.keybindings": {"icon": "", "label": "Atajos de teclado", "when": "[[ -f ~/.config/hypr/bindings.lua ]]", "action": "omarchy-launch-config-editor \"$HOME/.config/hypr/bindings.lua\""},
  "setup.input": {"icon": "", "label": "Entrada", "when": "[[ -f ~/.config/hypr/input.lua ]]", "action": "omarchy-launch-config-editor \"$HOME/.config/hypr/input.lua\""},
  "setup.network": {"icon": "󰛳", "label": "Red", "aliases": ["network"]},
  "setup.network.dns": {"icon": "󰇖", "label": "DNS", "aliases": ["dns"]},
  "setup.network.dns.dhcp": {"icon": "󰩟", "label": "DHCP", "checked": "[[ \"$(omarchy-dns)\" == \"DHCP\" ]]", "action": "omarchy-dns DHCP"},
  "setup.network.dns.cloudflare": {"icon": "󰅟", "label": "Cloudflare", "checked": "[[ \"$(omarchy-dns)\" == \"Cloudflare\" ]]", "action": "omarchy-dns Cloudflare"},
  "setup.network.dns.google": {"icon": "󰊭", "label": "Google", "checked": "[[ \"$(omarchy-dns)\" == \"Google\" ]]", "action": "omarchy-dns Google"},
  "setup.network.dns.custom": {"icon": "", "label": "Personalizado", "checked": "[[ \"$(omarchy-dns)\" == \"Custom\" ]]", "action": "omarchy-launch-floating-terminal-with-presentation 'omarchy-dns Custom'"},
  "setup.network.qr": {"icon": "󰐲", "label": "Código QR", "aliases": ["wifi-qr"], "when": "[[ $(omarchy-network-status) == wifi* ]]", "action": "omarchy-shell shell summon omarchy.wifiqr"},
  "setup.default": {"icon": "", "label": "Predeterminados", "aliases": ["default", "defaults"]},
  "setup.default.agent": {"icon": "󰚩", "label": "Agente", "title": "Agente predeterminado"},
  "setup.default.agent.claude": {"icon": "󰛄", "label": "Claude", "checked": "[[ \"$(omarchy-default-agent)\" == \"claude\" ]]", "action": "omarchy-default-agent claude"},
  "setup.default.agent.codex": {"icon": "", "iconFont": "omarchy", "label": "Codex", "checked": "[[ \"$(omarchy-default-agent)\" == \"codex\" ]]", "action": "omarchy-default-agent codex"},
  "setup.default.agent.copilot": {"icon": "", "label": "Copilot", "checked": "[[ \"$(omarchy-default-agent)\" == \"copilot\" ]]", "action": "omarchy-default-agent copilot"},
  "setup.default.agent.crush": {"icon": "󰋑", "label": "Crush", "checked": "[[ \"$(omarchy-default-agent)\" == \"crush\" ]]", "action": "omarchy-default-agent crush"},
  "setup.default.agent.cursor-agent": {"icon": "", "iconFont": "omarchy", "label": "Cursor CLI", "checked": "[[ \"$(omarchy-default-agent)\" == \"cursor-agent\" ]]", "action": "omarchy-default-agent cursor-agent"},
  "setup.default.agent.gemini": {"icon": "󰫢", "label": "Gemini", "checked": "[[ \"$(omarchy-default-agent)\" == \"gemini\" ]]", "action": "omarchy-default-agent gemini"},
  "setup.default.agent.grok": {"icon": "", "iconFont": "omarchy", "label": "Grok", "checked": "[[ \"$(omarchy-default-agent)\" == \"grok\" ]]", "action": "omarchy-default-agent grok"},
  "setup.default.agent.hermes": {"icon": "", "iconFont": "omarchy", "label": "Hermes", "checked": "[[ \"$(omarchy-default-agent)\" == \"hermes\" ]]", "action": "omarchy-default-agent hermes"},
  "setup.default.agent.muse": {"icon": "󰛤", "label": "Muse Code", "checked": "[[ \"$(omarchy-default-agent)\" == \"muse\" ]]", "action": "omarchy-default-agent muse"},
  "setup.default.agent.omp": {"icon": "", "iconFont": "omarchy", "label": "omp", "checked": "[[ \"$(omarchy-default-agent)\" == \"omp\" ]]", "action": "omarchy-default-agent omp"},
  "setup.default.agent.openclaw": {"icon": "", "iconFont": "omarchy", "label": "OpenClaw", "checked": "[[ \"$(omarchy-default-agent)\" == \"openclaw\" ]]", "action": "omarchy-default-agent openclaw"},
  "setup.default.agent.opencode": {"icon": "", "iconFont": "omarchy", "label": "OpenCode", "checked": "[[ \"$(omarchy-default-agent)\" == \"opencode\" ]]", "action": "omarchy-default-agent opencode"},
  "setup.default.agent.pi": {"icon": "", "iconFont": "omarchy", "label": "Pi", "checked": "[[ \"$(omarchy-default-agent)\" == \"pi\" ]]", "action": "omarchy-default-agent pi"},
  "setup.default.browser": {"icon": "", "label": "Navegador", "title": "Navegador predeterminado"},
  "setup.default.browser.chromium": {"icon": "", "label": "Chromium", "when": "omarchy-cmd-present chromium", "checked": "[[ \"$(omarchy-default-browser)\" == \"chromium\" ]]", "action": "omarchy-default-browser chromium"},
  "setup.default.browser.chrome": {"icon": "󰊯", "label": "Chrome", "when": "omarchy-cmd-present google-chrome-stable", "checked": "[[ \"$(omarchy-default-browser)\" == \"chrome\" ]]", "action": "omarchy-default-browser chrome"},
  "setup.default.browser.brave": {"icon": "󰖟", "label": "Brave", "when": "omarchy-cmd-present brave", "checked": "[[ \"$(omarchy-default-browser)\" == \"brave\" ]]", "action": "omarchy-default-browser brave"},
  "setup.default.browser.brave-origin": {"icon": "󰖟", "label": "Brave Origin", "when": "omarchy-cmd-present brave-origin", "checked": "[[ \"$(omarchy-default-browser)\" == \"brave-origin\" ]]", "action": "omarchy-default-browser brave-origin"},
  "setup.default.browser.edge": {"icon": "󰇩", "label": "Edge", "when": "omarchy-cmd-present microsoft-edge-stable", "checked": "[[ \"$(omarchy-default-browser)\" == \"edge\" ]]", "action": "omarchy-default-browser edge"},
  "setup.default.browser.firefox": {"icon": "", "label": "Firefox", "when": "omarchy-cmd-present firefox", "checked": "[[ \"$(omarchy-default-browser)\" == \"firefox\" ]]", "action": "omarchy-default-browser firefox"},
  "setup.default.browser.zen": {"icon": "󰖟", "label": "Zen", "when": "omarchy-cmd-present zen-browser", "checked": "[[ \"$(omarchy-default-browser)\" == \"zen\" ]]", "action": "omarchy-default-browser zen"},
  "setup.default.terminal": {"icon": "", "label": "Terminal", "title": "Terminal predeterminada"},
  "setup.default.terminal.alacritty": {"icon": "", "label": "Alacritty", "when": "omarchy-cmd-present alacritty", "checked": "[[ \"$(omarchy-default-terminal)\" == \"alacritty\" ]]", "action": "omarchy-default-terminal alacritty"},
  "setup.default.terminal.foot": {"icon": "", "label": "Foot", "when": "omarchy-cmd-present foot", "checked": "[[ \"$(omarchy-default-terminal)\" == \"foot\" ]]", "action": "omarchy-default-terminal foot"},
  "setup.default.terminal.ghostty": {"icon": "", "label": "Ghostty", "when": "omarchy-cmd-present ghostty", "checked": "[[ \"$(omarchy-default-terminal)\" == \"ghostty\" ]]", "action": "omarchy-default-terminal ghostty"},
  "setup.default.terminal.kitty": {"icon": "", "label": "Kitty", "when": "omarchy-cmd-present kitty", "checked": "[[ \"$(omarchy-default-terminal)\" == \"kitty\" ]]", "action": "omarchy-default-terminal kitty"},
  "setup.default.editor": {"icon": "", "label": "Editor", "title": "Editor predeterminado"},
  "setup.default.editor.neovim": {"icon": "", "label": "Neovim", "when": "omarchy-cmd-present nvim", "checked": "[[ \"$(omarchy-default-editor)\" == \"nvim\" ]]", "action": "omarchy-default-editor nvim"},
  "setup.default.editor.vscode": {"icon": "", "label": "VSCode", "when": "omarchy-cmd-present code", "checked": "[[ \"$(omarchy-default-editor)\" == \"code\" ]]", "action": "omarchy-default-editor code"},
  "setup.default.editor.cursor": {"icon": "", "iconFont": "omarchy", "label": "Cursor", "when": "omarchy-cmd-present cursor", "checked": "[[ \"$(omarchy-default-editor)\" == \"cursor\" ]]", "action": "omarchy-default-editor cursor"},
  "setup.default.editor.zed": {"icon": "", "label": "Zed", "when": "omarchy-cmd-present zeditor", "checked": "[[ \"$(omarchy-default-editor)\" == \"zeditor\" ]]", "action": "omarchy-default-editor zed"},
  "setup.default.editor.sublime": {"icon": "", "label": "Sublime Text", "when": "omarchy-cmd-present sublime_text", "checked": "[[ \"$(omarchy-default-editor)\" == \"sublime_text\" ]]", "action": "omarchy-default-editor sublime_text"},
  "setup.default.editor.helix": {"icon": "", "label": "Helix", "when": "omarchy-cmd-present helix", "checked": "[[ \"$(omarchy-default-editor)\" == \"helix\" ]]", "action": "omarchy-default-editor helix"},
  "setup.default.editor.vim": {"icon": "", "label": "Vim", "when": "omarchy-cmd-present vim", "checked": "[[ \"$(omarchy-default-editor)\" == \"vim\" ]]", "action": "omarchy-default-editor vim"},
  "setup.default.editor.emacs": {"icon": "", "label": "Emacs", "when": "omarchy-cmd-present emacs", "checked": "[[ \"$(omarchy-default-editor)\" == \"emacs\" ]]", "action": "omarchy-default-editor emacs"},
  "setup.plugin": {"icon": "󰐱", "label": "Plugins", "aliases": ["plugin", "plugins"]},
  "setup.plugin.enable": {"icon": "󰄬", "label": "Activar plugin", "action": "omarchy-menu-plugin enable"},
  "setup.plugin.disable": {"icon": "󰅖", "label": "Desactivar plugin", "action": "omarchy-menu-plugin disable"},
  "setup.plugin.add": {"icon": "󰖟", "label": "Añadir plugin", "action": "omarchy-launch-floating-terminal-with-presentation 'omarchy-plugin-add'"},
  "setup.plugin.clone": {"icon": "󰆏", "label": "Clonar plugin", "action": "omarchy-menu-plugin clone"},
  "setup.plugin.remove": {"icon": "󰭌", "label": "Eliminar plugin", "when": "compgen -G \"$HOME/.config/omarchy/plugins/*/manifest.json\"", "action": "omarchy-menu-plugin remove"},
  "setup.security": {"icon": "", "label": "Seguridad"},
  "setup.config": {"icon": "", "label": "Configuración"},
  "setup.security.fingerprint": {"icon": "󰈷", "label": "Huella dactilar", "when": "omarchy-hw-fingerprint", "action": "omarchy-launch-floating-terminal-with-presentation omarchy-setup-security-fingerprint"},
  "setup.security.fido2": {"icon": "", "label": "Fido2", "action": "omarchy-launch-floating-terminal-with-presentation omarchy-setup-security-fido2"},
