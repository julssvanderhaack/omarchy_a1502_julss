{
  "bar": {
    "centerAnchor": "omarchy.weather",
    "layout": {
      "center": [
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.indicators",
          "items": [
            "Dictation",
            "ScreenRecording",
            "Reminder",
            "NightLight",
            "StayAwake"
          ]
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "julss.menu"
        },
        {
          "id": "julss.places"
        },
        {
          "id": "julss.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "rogergdot.forcequit"
        },
        {
          "id": "omarchy.dropbox"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "julss.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "julss.monitor"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "julss.power",
          "showPercentage": true
        },
        {
          "id": "julss.clock",
          "format": "ddd d MMM HH:mm:ss",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "julss.notifications"
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "io.github.cjgarcia1229.monitor-layout"
    },
    {
      "id": "vbrosseau.alttab"
    }
  ],
  "version": 1
}
