{
  "bar": {
    "centerAnchor": "omarchy.weather",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "julss.menu"
        },
        {
          "id": "julss.places"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "rogergdot.forcequit"
        },
        {
          "id": "omarchy.dropbox"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        },
        {
          "id": "julss.clock",
          "format": "h:mm:ss AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
