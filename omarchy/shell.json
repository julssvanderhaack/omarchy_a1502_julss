{
  "bar": {
    "centerAnchor": "omarchy.indicators",
    "layout": {
      "center": [
        {
          "id": "julss.keyboard-layout"
        },
        {
          "id": "julss.indicators",
          "items": [
            "Dictation",
            "ScreenRecording",
            "Reminder",
            "NightLight",
            "StayAwake",
            "Webcam",
            "KeyboardBacklight"
          ]
        },
        {
          "id": "julss.system-update"
        }
      ],
      "left": [
        {
          "id": "julss.menu"
        },
        {
          "id": "julss.places"
        },
        {
          "id": "julss.workspaces"
        },
        {
          "id": "julss.media"
        }
      ],
      "right": [
        {
          "id": "julss.tray"
        },
        {
          "id": "julss.forcequit"
        },
        {
          "id": "julss.dropbox"
        },
        {
          "id": "julss.bluetooth"
        },
        {
          "id": "julss.network"
        },
        {
          "id": "julss.audio"
        },
        {
          "id": "julss.monitor"
        },
        {
          "id": "julss.lan"
        },
        {
          "id": "julss.agents"
        },
        {
          "id": "julss.power",
          "showPercentage": true
        },
        {
          "format": "ddd d MMM HH:mm:ss",
          "formatAlt": "d 'de' MMMM 'S'ww yyyy",
          "id": "julss.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "julss.weather"
        },
        {
          "id": "julss.notifications"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "cloneSourceRestores": [
    "julss.notifications-service",
    "julss.speedtest",
    "julss.wifiqr",
    "julss.emojis",
    "julss.clipboard",
    "julss.reminders",
    "julss.media"
  ],
  "disabledPlugins": [
    "omarchy.notifications",
    "omarchy.speedtest",
    "omarchy.wifiqr",
    "omarchy.emojis",
    "omarchy.clipboard",
    "omarchy.reminders",
    "omarchy.media"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "io.github.cjgarcia1229.monitor-layout"
    },
    {
      "id": "vbrosseau.alttab"
    },
    {
      "id": "julss.notifications-service"
    },
    {
      "id": "julss.speedtest"
    },
    {
      "id": "julss.wifiqr"
    },
    {
      "id": "julss.emojis"
    },
    {
      "id": "julss.clipboard"
    },
    {
      "id": "julss.reminders"
    }
  ],
  "version": 1
}
